def build_group_text(pid):
    o = orders.get(pid, {})
    gm = group_messages.get(pid, {})
    parts = gm.get("parts", [])
    total = len(parts)
    buyer = o.get("username", "—")
    pubg = o.get("pubg_id", "—")
    item = o.get("item_name", "—")
    price = o.get("price", "—")
    
    text = (
        f'{em(E_BOX, "📦")} <b>НОВЫЙ ЗАКАЗ В СОПРОВОЖДЕНИЕ</b> {em(E_BOX, "📦")}\n\n'
        f'{em(E_USER, "👤")} Купил: @{buyer}\n'
        f'{em(E_USER, "🆔")} PUBG ID: <code>{pubg}</code>\n\n'
        f'{em(E_BOX, "📦")} Товар: <b>{item}</b>\n'
        f'{em(E_PRICE, "💵")} Цена: {price}₽\n\n'
        f'{em(E_USER, "👥")} Участвуют: {", ".join(parts)} ({total}/{MAX_PARTICIPANTS})'
    )
    return text

